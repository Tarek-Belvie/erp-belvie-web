# ================================================================================================
# Modèle de configuration — copier en .env et remplir. Le fichier .env n'est JAMAIS versionné.
# ================================================================================================

# --- Base PostgreSQL ------------------------------------------------------------------------------
# Neon : utiliser l'URL « unpooled » (sans -pooler) pour les migrations et pg_dump.
# Base locale (profil base-locale) : postgres://belvie:<POSTGRES_PASSWORD>@postgres:5432/belvie
# Développement (docker-compose.dev.yml) : postgres://belvie:belvie@localhost:5432/belvie
DATABASE_URL=
POSTGRES_PASSWORD=

# --- API ------------------------------------------------------------------------------------------
PORT=3001
# Domaine public de l'API (HTTPS automatique par Caddy). Le front Vercel y redirige /api et /media.
DOMAINE_API=api.exemple.fr
# Origines autorisées à appeler l'API directement (inutile quand le front passe par les réécritures Vercel).
ORIGINES_AUTORISEES=
DUREE_SESSION_JOURS=14
# Nombre de proxys devant l'API : 2 en production (Vercel → Caddy → API), pour lire la vraie IP
# du visiteur (limitation des tentatives de connexion). 1 si on accède à Caddy sans Vercel.
TRUST_PROXY=2
# Dossiers (déjà réglés dans l'image Docker) :
# DOSSIER_DONNEES=/donnees/fichiers
# DOSSIER_SAUVEGARDES=/donnees/sauvegardes

# --- Stockage des fichiers (photos, croquis, logo) ------------------------------------------------
# disque (défaut : DOSSIER_DONNEES) ou r2 (obligatoire sur Vercel). En mode r2, les variables R2_*
# ci-dessous servent aussi aux fichiers, rangés sous R2_PREFIXE_FICHIERS dans le même bucket.
STOCKAGE=disque
R2_PREFIXE_FICHIERS=fichiers/

# --- Bascule des données Electron (reprise-vers-neon.bat) — facultatif, sinon l'URL est demandée --
NEON_DATABASE_URL_UNPOOLED=

# --- Sauvegarde quotidienne vers Cloudflare R2 ----------------------------------------------------
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=belvie-backup
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PREFIXE=base/
R2_VERSIONS=5
HEURE_SAUVEGARDE=00:00
TZ_SAUVEGARDE=Europe/Paris

# --- E-mail de compte rendu des sauvegardes (SMTP) -----------------------------------------------
# Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=<adresse>, SMTP_PASS=<mot de passe d'application>
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURISE=1
SMTP_USER=
SMTP_PASS=
MAIL_EXPEDITEUR=
MAIL_DESTINATAIRE=tarek.bouhejba2@gmail.com
