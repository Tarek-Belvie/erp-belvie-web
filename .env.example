# ============================================================================
# MODELE de variables d'environnement — Phase 0.
#
# Ce fichier ne contient AUCUNE vraie valeur, uniquement la liste de ce qui
# sera necessaire. Ne jamais remplir de vraies valeurs directement ici :
# copier ce fichier en .env (ignore par Git) et y mettre les vraies valeurs
# la, ou les configurer directement dans les variables d'environnement de
# Vercel/Supabase selon ce qui sera decide au moment venu.
#
# Aucune valeur reelle n'a ete demandee ni transmise a ce stade (Phase 0).
# ============================================================================

# --- Supabase (base de donnees PostgreSQL + authentification) ---
# Cote serveur (server/.env ou variables Vercel) :
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=

# Cote frontend (Vite — necessairement prefixees VITE_, jamais de secret ici) :
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_BASE_URL=

# --- Cloudflare R2 (stockage fichiers) — pour une phase ulterieure ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
