{
  "name": "belvie-erp",
  "version": "1.0.1",
  "description": "Belvie ERP - Module Commandes de production (application desktop locale)",
  "private": true,
  "main": "electron/main.js",
  "author": "Belvie",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && electron-builder",
    "build:win": "npm run build:renderer && electron-builder --win nsis",
    "postinstall": "electron-builder install-app-deps",
    "diagnostic": "cross-env ELECTRON_RUN_AS_NODE=1 electron diagnostic-belvie.js diagnostic-belvie.txt",
    "icone": "cross-env ELECTRON_RUN_AS_NODE=1 electron preparer-icone.js",
    "icone:valider": "cross-env ELECTRON_RUN_AS_NODE=1 electron preparer-icone.js /valider",
    "installateur": "npm run installateur:prerequis && npm run installateur:outils && npm run installateur:modules && npm run build:renderer && electron-builder --win nsis && npm run installateur:verifier && npm run installateur:archiver",
    "installateur:prerequis": "cross-env ELECTRON_RUN_AS_NODE=1 electron verifier-installateur.js --prerequis",
    "installateur:modules": "electron-builder install-app-deps",
    "installateur:verifier": "cross-env ELECTRON_RUN_AS_NODE=1 electron verifier-installateur.js",
    "installateur:archiver": "cross-env ELECTRON_RUN_AS_NODE=1 electron verifier-installateur.js --archiver",
    "installateur:outils": "node preparer-outils-build.js",
    "diagnostic:recette": "cross-env ELECTRON_RUN_AS_NODE=1 electron diagnostic-recette.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.33.5",
    "xlsx": "^0.18.5",
    "@supabase/supabase-js": "^2.45.0",
    "express": "^4.19.2",
    "pg": "^8.13.0",
    "cors": "^2.8.5",
    "@tiptap/react": "^2.10.3",
    "@tiptap/pm": "^2.10.3",
    "@tiptap/core": "^2.10.3",
    "@tiptap/starter-kit": "^2.10.3",
    "@tiptap/extension-underline": "^2.10.3",
    "@tiptap/extension-text-style": "^2.10.3",
    "@tiptap/extension-color": "^2.10.3",
    "@tiptap/extension-highlight": "^2.10.3",
    "@tiptap/extension-font-family": "^2.10.3",
    "@tiptap/extension-text-align": "^2.10.3",
    "@tiptap/extension-table": "^2.10.3",
    "@tiptap/extension-table-row": "^2.10.3",
    "@tiptap/extension-table-cell": "^2.10.3",
    "@tiptap/extension-table-header": "^2.10.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.belvie.erp",
    "productName": "Belvie ERP",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**",
      "**/*.node"
    ],
    "extraResources": [],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "artifactName": "Belvie-ERP-Setup-${version}.${ext}",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "allowElevation": false,
      "installerLanguages": [
        "fr_FR"
      ],
      "language": "1036"
    }
  }
}
